# ApplyPilot environment. Copy to .env (or run `applypilot setup`, which creates it and fills the tokens).
# NEVER commit .env. Secrets here are never written to the database, logs or MCP responses.

# --- Local backend (bind to loopback only) ---------------------------------------------
APPLYPILOT_TOKEN=            # random; authenticates the Firefox extension, dashboard and local MCP (setup generates it)
APPLYPILOT_MCP_TOKEN=        # random; capability URL for ChatGPT: https://<tunnel>/mcp/<APPLYPILOT_MCP_TOKEN>
APPLYPILOT_HOST=127.0.0.1
APPLYPILOT_PORT=8765
APPLYPILOT_DATA_DIR=data     # database, logs, screenshots (relative to the project root)

# --- ATS accounts (Workday, iCIMS, ... create an account per site) -------------------------
# One password used when ApplyPilot must create or sign in to an applicant account.
# Use a unique password you do not use elsewhere (8+ chars, upper, lower, digit, symbol).
APPLYPILOT_ACCOUNT_EMAIL=    # optional; defaults to candidate.yaml identity.email
APPLYPILOT_ACCOUNT_PASSWORD=
# Per-domain overrides are named in preferences.yaml accounts.domains (e.g. WORKDAY_PASSWORD=...).

# --- Email verification (optional; enables automatic codes/links) ------------------------
# IMAP with an app password (Gmail: Google Account → Security → App passwords).
APPLYPILOT_IMAP_HOST=        # e.g. imap.gmail.com
APPLYPILOT_IMAP_PORT=993
APPLYPILOT_IMAP_USER=
APPLYPILOT_IMAP_PASSWORD=
APPLYPILOT_IMAP_FOLDER=INBOX

# --- Optional cloud tiers (disabled by default in hybrid mode) -----------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Firefox add-on signing for permanent install (optional; see README) --------------------
WEB_EXT_API_KEY=
WEB_EXT_API_SECRET=
